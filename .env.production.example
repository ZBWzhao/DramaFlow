# 复制为 .env.production 后填写。不要把真实密钥提交到 Git。
DEEPSEEK_API_KEY=
POSTGRES_PASSWORD=replace-with-a-long-random-password

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 不配置真实媒体服务时保留 mock，可完整演示审批、队列和回填且不会扣费。
MEDIA_PROVIDER=mock
TF_ROUTER_API_KEY=
TF_ROUTER_BASE_URL=https://api.toonflow.net/v1

# 本机默认仅允许本机访问；部署到服务器并配置反向代理后仍建议保持 127.0.0.1。
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
DRAMAFLOW_PROJECT_ID=default
DRAMAFLOW_IMAGE_TAG=latest
