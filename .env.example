# 语言模型
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 媒体 Provider：默认 mock，避免误扣费。
# 配置 Key 后，前端会自动出现 TF-router / Seedance 等真实模型选项。
TF_ROUTER_API_KEY=
TF_ROUTER_BASE_URL=https://api.toonflow.net/v1
MEDIA_PROVIDER=mock
MEDIA_GENERATION_TIMEOUT=1800
MEDIA_POLL_INTERVAL=3

# 事件存储：开发环境默认 memory；多实例/断线补发可切换 Redis Streams。
# Redis 模式连接失败会阻止服务启动，不会静默退回内存。
EVENT_STORE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
EVENT_STREAM_PREFIX=dramaflow:events
EVENT_STREAM_MAXLEN=5000
# 默认跟随 EVENT_STORE_BACKEND；也可以单独设为 memory/redis。
RUN_STATE_STORE_BACKEND=
RUN_STATE_PREFIX=dramaflow
RUN_STATE_RETENTION_SECONDS=86400
RUN_ACTIVE_TTL_SECONDS=7200
RUN_STALE_SECONDS=20
# 默认跟随运行状态存储。
QUESTION_STORE_BACKEND=
QUESTION_TTL_SECONDS=86400
# 副作用工具与人工审批：默认跟随 RUN_STATE_STORE_BACKEND / EVENT_STORE_BACKEND。
# 多实例部署时设置为 redis，避免不同进程重复执行同一工具调用。
INVOCATION_STORE_BACKEND=
INVOCATION_TTL_SECONDS=604800
# 后台媒体任务：默认跟随 invocation/event backend。Redis 模式可在服务重启后恢复尚未领取的任务。
MEDIA_JOB_STORE_BACKEND=
MEDIA_JOB_TTL_SECONDS=604800
MEDIA_JOB_LEASE_SECONDS=30
# 单机开发保持 true；独立 Worker 部署时 API 设为 false，并运行 python -m server.media_worker。
MEDIA_WORKER_EMBEDDED=true

# 成片合成：未配置时从 PATH（以及 Windows WinGet Links）发现。
FFMPEG_BIN=
FFPROBE_BIN=
COMPOSITION_TIMEOUT_SECONDS=1800
FFPROBE_TIMEOUT_SECONDS=30

# TTS：mock 可离线验证音频链路；真实语音使用 OpenAI-compatible /audio/speech。
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_TIMEOUT_SECONDS=180

# 持久业务数据：工具调用、审批和媒体任务可切到 PostgreSQL。
# Redis 继续承担实时事件、运行状态、Follow-up、租约与心跳。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dramaflow
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
# 可分别设为 postgres；未设置时仍沿用上面的 memory/redis 默认链。
# INVOCATION_STORE_BACKEND=postgres
# MEDIA_JOB_STORE_BACKEND=postgres
# MEDIA_ASSET_STORE_BACKEND=postgres
# CANVAS_STORE_BACKEND=postgres
# SESSION_STORE_BACKEND=postgres
# PRODUCTION_RUN_STORE_BACKEND=postgres
OUTBOX_PUBLISHER_ENABLED=false
OUTBOX_STREAM=dramaflow:outbox
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=30
OUTBOX_STREAM_MAXLEN=20000
OUTBOX_DEDUP_TTL_SECONDS=604800
DRAMAFLOW_PROJECT_ID=default
# 单次 Agent 工具循环上限；达到后保存检查点并显示“继续制作”，不会伪装成已完成。
AGENT_MAX_TURNS=40
